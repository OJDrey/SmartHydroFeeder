{
  "version": 1,
  "author": "SmartHydroFeeder",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-hc-sr04", "id": "sonar", "top": -120, "left": 190, "attrs": { "distance": "5" } },
    { "type": "board-ssd1306", "id": "oled", "top": 60, "left": 200, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 180, "left": 200, "attrs": { "color": "green", "bounce": "1" } },
    { "type": "wokwi-hx711", "id": "scale", "top": 40, "left": -260, "attrs": { "type": "5kg" } },
    { "type": "wokwi-led", "id": "pump", "top": 170, "left": -200, "attrs": { "color": "blue", "label": "PUMP" } },
    { "type": "wokwi-resistor", "id": "r_pump", "top": 250, "left": -210, "attrs": { "value": "220" } },
    { "type": "wokwi-slide-switch", "id": "float", "top": 170, "left": -110, "attrs": {} },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 280, "left": -110, "attrs": { "volume": "0.2" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "sonar:VCC", "esp:5V", "red", [] ],
    [ "sonar:GND", "esp:GND.2", "black", [] ],
    [ "sonar:TRIG", "esp:32", "orange", [] ],
    [ "sonar:ECHO", "esp:35", "yellow", [] ],

    [ "oled:VCC", "esp:3V3", "red", [] ],
    [ "oled:GND", "esp:GND.2", "black", [] ],
    [ "oled:SDA", "esp:26", "blue", [] ],
    [ "oled:SCL", "esp:27", "green", [] ],

    [ "btn:1.l", "esp:25", "purple", [] ],
    [ "btn:2.l", "esp:GND.1", "black", [] ],

    [ "scale:VCC", "esp:5V", "red", [] ],
    [ "scale:GND", "esp:GND.1", "black", [] ],
    [ "scale:DT", "esp:19", "cyan", [] ],
    [ "scale:SCK", "esp:23", "white", [] ],

    [ "pump:A", "esp:33", "blue", [] ],
    [ "pump:C", "r_pump:1", "black", [] ],
    [ "r_pump:2", "esp:GND.1", "black", [] ],

    [ "float:2", "esp:34", "green", [] ],
    [ "float:1", "esp:3V3", "red", [] ],
    [ "float:3", "esp:GND.1", "black", [] ],

    [ "buzzer:2", "esp:4", "orange", [] ],
    [ "buzzer:1", "esp:GND.1", "black", [] ]
  ],
  "serialMonitor": { "display": "terminal", "convertEol": true },
  "dependencies": {}
}
