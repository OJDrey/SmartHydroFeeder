# Скопіюйте цей файл у .env і впишіть свої значення.
# Токен видає @BotFather (після /revoke старий токен перестає працювати).
TELEGRAM_TOKEN=123456789:ВАШ_НОВИЙ_ТОКЕН
TELEGRAM_CHAT_ID=ВАШ_CHAT_ID
DEVICE_ID=device123
MQTT_SERVER=broker.hivemq.com
# Хмарний брокер (EMQX Cloud Serverless): адреса і облікові дані БОТА.
# Якщо задано логін, бот підключається через TLS на порт 8883.
# MQTT_SERVER=xxxxxxxx.ala.eu-central-1.emqxsl.com
# MQTT_USERNAME=bot
# MQTT_PASSWORD=ПАРОЛЬ_БОТА
# Необов'язково: інші чати з доступом до команд (через кому) і шлях до бази вимірювань
# ALLOWED_CHAT_IDS=
# DB_PATH=smarthydrofeeder.db
